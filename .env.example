# ==============================================================================
# 1. DATABASE (REQUIRED)
# ==============================================================================
# In production on Vercel, paste your Neon or Supabase pooled connection string:
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# 2. AUTH & APP URL (REQUIRED)
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_ilearner_2026_xyz
FRONTEND_URL=https://your-app.vercel.app

# ==============================================================================
# 3. AMAZON ASSOCIATES & CREATORS API (RECOMMENDED)
# ==============================================================================
AMAZON_PARTNER_TAG=your_partner_tag_here
AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here

# ==============================================================================
# 4. WHATSAPP CLOUD API (OPTIONAL)
# ==============================================================================
WHATSAPP_PROVIDER=meta
META_VERIFY_TOKEN=ilearner_whatsapp_verify_token_2026
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
META_API_VERSION=v21.0
BOT_PHONE_NUMBER=+92 3181494914

# Twilio WhatsApp API (Alternative provider)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
